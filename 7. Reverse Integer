class Solution {
    public int reverse(int x) {

        int result = 0;

        while (x != 0) {

            int lastDig = x % 10;
            x /= 10;

            if (result > Integer.MAX_VALUE / 10 ||
                result < Integer.MIN_VALUE / 10) {
                return 0;
            }

            result = result * 10 + lastDig;
        }

        return result;
    }
}
