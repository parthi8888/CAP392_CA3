class Solution {
    public int[] plusOne(int[] digits) {

        boolean carry = false;

        for (int i = digits.length - 1; i >= 0; i--) {

            if (digits[i] == 9) {
                digits[i] = 0;
                carry = true;
                continue;
            } else {
                digits[i]++;
                carry = false;
                break;
            }
        }

        if (carry) {
            int[] result = new int[digits.length + 1];
            result[0] = 1;

            for (int i = 0; i < digits.length; i++) {
                result[i + 1] = digits[i];
            }

            return result;
        }

        return digits;
    }
}
